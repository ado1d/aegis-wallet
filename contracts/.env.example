# ------------------------------------------------------------------
# Aegis Wallet - contracts environment
# Copy to `.env` and fill in.  NEVER commit the real .env file.
# Use BURNER keys only (testnet keys hold no real funds).
# ------------------------------------------------------------------

# Owner = the human user's key (also the deployer).
# Default below is anvil's account #0 (LOCAL ONLY).
OWNER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Agent = the AI executor's key (used by the Checkpoint 2 backend).
# MUST be a different key than OWNER_KEY. Default is anvil's account #1.
AGENT_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# ---- RPC endpoints (free tiers are enough) -----------------------
# Sepolia options: Alchemy / Infura / LlamaRPC (https://llamarpc.com/sepolia)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# Polygon Amoy (optional alternative testnet)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# ---- Etherscan verification (optional) ---------------------------
ETHERSCAN_API_KEY=

# ---- Asset override (optional) ------------------------------------
# If unset, Deploy.s.sol deploys a MockUSDC and mints 10,000 demo USDC
# to the owner. To use real Sepolia USDC (Circle):
# USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
USDC_ADDRESS=

# ---- MockSwap fixed rate (optional, CP1.1) ------------------------
# USD price of ETH used to set the venue's USDC->ETH fixed rate.
# Default 4000 means $4,000 / ETH (200 USDC buys 0.05 ETH).
ETH_PRICE=4000
