# ── Chain (from Checkpoint 1) ────────────────────────────────────────────────
# RPC endpoint of the chain AegisVault is deployed on.
# Local anvil (CP1 guide, terminal 1):  http://127.0.0.1:8545
RPC_URL=http://127.0.0.1:8545

# Addresses printed by the CP1 deploy step (`forge script script/Deploy.s.sol ...`).
# On a FRESH anvil these are deterministic — the defaults below match the
# CP1 RUN-ON-YOUR-MACHINE guide exactly.
VAULT_ADDRESS=0x5FC8d32690cc91D4c39d9d3abcBD16989F875707
VENUE_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
USDC_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# ── Keys (LOCAL DEMO ONLY — these are the throwaway anvil accounts) ─────────
# owner = anvil account #0 (the human), agent = anvil account #1 (the AI's key)
# NEVER put a real mainnet key in this file.
OWNER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
AGENT_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# ── Intent extraction ────────────────────────────────────────────────────────
# auto         = DEFAULT — use the LLM whenever a key is present below
#               (OPENAI_API_KEY first, then HF_TOKEN); rules only if neither
#               is set. Recommended: just fill OPENAI_API_KEY, leave this.
# rules        = deterministic parser only (works offline, no API keys)
# openai       = your OpenAI key (or any compatible endpoint: DeepSeek, Groq,
#                local Ollama…) — recommended, see RUN-PRODUCT-LOCALLY.md §8
# huggingface  = HF Inference Providers router — a free hf.co token in
#                HF_TOKEN below (optional extra, same §8)
# all          = try every configured LLM in order, fall back to rules on any
#                failure (recommended once your key works)
LLM_PROVIDER=auto
# Empty = provider default (openai: gpt-4o-mini · huggingface:
# meta-llama/Llama-3.1-8B-Instruct). gpt-5*/o-series reasoning models
# (e.g. gpt-5-nano) work too — the agent auto-omits `temperature` and pins
# reasoning_effort=low for them. Commands can be English or romanized
# Bengali (Banglish): "tui amr savings e 50 dollar patha" works.
LLM_MODEL=
# Your key from platform.openai.com → API keys (starts with sk-…).
# gpt-4o-mini costs ~$0.0001 per command — a $30 credit ≈ 100k+ commands.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
HF_BASE_URL=https://router.huggingface.co/v1
LLM_TIMEOUT_MS=15000
# Circuit breaker cooldown: after 2 consecutive LLM failures intents parse
# INSTANTLY via the rules engine (no 10s timeout per message) until this many
# ms elapse, then the LLM is retried automatically.
LLM_COOLDOWN_MS=60000
# ONLY needed when your machine reaches the internet through a proxy/VPN that
# Node's fetch can't see (typical on WSL behind a Windows VPN — symptom:
# "LLM unavailable — rules fallback: fetch failed"). Set it to the proxy your
# browser uses, e.g. http://172.20.16.1:7890, and run `npm i undici` once.
# Find the Windows host IP from WSL with:  cat /etc/resolv.conf | grep nameserver
HTTPS_PROXY=

# ── Hugging Face token (OPTIONAL — different job from OPENAI_API_KEY) ───────
# Only needed for the `huggingface` LLM provider and/or the advisory risk
# signals (FinBERT sentiment + MiniLM embedding similarity). Create free at
# huggingface.co → Settings → Access Tokens. Without it the agent runs the
# deterministic rules parser + 4 risk families and never blocks anything.
HF_TOKEN=

# ── Risk / decision tuning ───────────────────────────────────────────────────
AUTO_RISK_THRESHOLD=30      # score below this  -> autonomous execute
REJECT_RISK_THRESHOLD=60    # score above this  -> reject + on-chain log
VELOCITY_WINDOW_ENTRIES=6   # live window entries that trip the velocity check
AMOUNT_ANOMALY_X=3          # x times the recent-spend median = anomaly
SLIPPAGE_BPS=150            # swap minOut = quote * (1 - bps/10000)

# ── Behaviour ────────────────────────────────────────────────────────────────
PORT=8787
HOST=127.0.0.1              # 0.0.0.0 only when hosting on a VPS
DRY_RUN=false               # true = decide + explain, never broadcast (eval mode)
EVENT_POLL=true              # poll vault events into the audit journal
JOURNAL_FILE=data/journal.jsonl

# ── Demo faucet (CP3 judge quickstart; guard rails live in the agent) ────────
FAUCET_ENABLED=true          # false = /faucet/claim always refuses
FAUCET_AMOUNT_USDC=1000      # mock USDC per claim
FAUCET_COOLDOWN_MIN=60       # per-address cooldown (minutes)
FAUCET_DAILY_MAX=24          # global claims per UTC day

# ── PRODUCT MODE (real-user accounts + per-user vaults) ──────────────────────
# judge (default) = the single CP1..CP4 demo vault, exactly as before.
# product         = email/password accounts, per-user embedded wallets, a
#                   per-user AegisVault deployed at signup, Postgres sessions.
AEGIS_MODE=judge

# Postgres (Neon free tier, docker, anything). Empty = in-memory store
# (works for local play, accounts vanish on restart).
DATABASE_URL=

# Secret used to seal the relayer copy of each user's embedded wallet key.
# GENERATE:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing it = users can still self-export keys with their password.
AEGIS_SERVER_SECRET=

SESSION_TTL_HOURS=168        # login lifetime

# New-account provisioning (gas paid by AGENT_KEY from one operational pot)
USDC_SEED_AMOUNT=5000        # tUSDC minted into each new vault
ETH_SEED_AMOUNT=0.05         # native ETH seeded into each new vault
GAS_STIPEND_ETH=0.003        # owner-op gas money sent to each user key

# Default per-user guardrails the provisioner configures before handing over
PRODUCT_USDC_MAX_PER_TX=1000
PRODUCT_USDC_DAILY=2500
PRODUCT_ETH_MAX_PER_TX=0.05
PRODUCT_ETH_DAILY=0.2

# Ping target that keeps free tiers awake (set to the dashboard URL in prod)
KEEPALIVE_URL=

# One-click demo account (created by `npm run seed:demo`)
DEMO_EMAIL=demo@aegis.app
DEMO_PASSWORD=aegis-demo-2026
