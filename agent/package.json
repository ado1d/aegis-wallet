{
  "name": "aegis-agent",
  "version": "3.9.5",
  "description": "Aegis Wallet agent backend: accounts, per-user vaults, multilingual intent parsing, risk engine, policy enforcement",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node scripts/migrate.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "eval": "node eval/run-eval.js",
    "eval:llm": "LLM_PROVIDER=all node eval/run-eval.js",
    "build:corpora": "node eval/build-corpora.js",
